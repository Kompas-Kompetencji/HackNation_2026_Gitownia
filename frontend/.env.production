# Build produkcyjny (npm run build / Dockerfile): wszystkie funkcje z prawdziwego backendu.
# Frontend jest serwowany przez backend z tego samego adresu, więc ścieżka względna działa bez CORS.
# Osobny hosting frontendu: ustaw VITE_API_URL=https://<adres-backendu>/api/v1 przy budowaniu.
VITE_USE_MOCKS=false
VITE_REAL_API=*
VITE_API_URL=/api/v1
