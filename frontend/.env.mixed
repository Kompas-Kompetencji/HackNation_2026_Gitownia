# Tryb z prawdziwym API: npm run dev:mixed (vite --mode mixed). Backend (gałąź backend-dane) na porcie 8000.
# "*" = wszystkie funkcje gotowe w backendzie; makiety tylko dla funkcji, których nie ma na tej liście.
VITE_USE_MOCKS=true
VITE_REAL_API=*
VITE_API_URL=/api/v1
BACKEND_PROXY_TARGET=http://localhost:8000
