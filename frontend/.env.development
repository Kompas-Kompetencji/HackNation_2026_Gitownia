# true = dane przykładowe z src/lib/mocks, false = zapytania do backendu
VITE_USE_MOCKS=true
# Adres backendu widziany z przeglądarki. "/api" działa przez proxy Vite (bez CORS).
VITE_API_URL=/api
# Tylko dla serwera deweloperskiego: dokąd proxy przekazuje /api
BACKEND_PROXY_TARGET=http://localhost:8000
