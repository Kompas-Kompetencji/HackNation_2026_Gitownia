# true = dane przykładowe z src/lib/mocks (poza funkcjami z VITE_REAL_API), false = wszystko z backendu
VITE_USE_MOCKS=true
# Tryb mieszany: funkcje api.ts działające na prawdziwym API, oddzielone przecinkami; reszta zostaje na makietach.
# Gotowe w backendzie: getCompetencies, analyzeOsp, calculateScore, evaluateAssessment, askAiAssistant,
# exportAssessmentPdf, getAssessmentTemplate, getFirstAssessmentSchedule ("*" = wszystkie gotowe).
# Przykład: VITE_REAL_API=getCompetencies,analyzeOsp,calculateScore,askAiAssistant,exportAssessmentPdf
VITE_REAL_API=
# Adres backendu widziany z przeglądarki. Trasy backendu są pod /api/v1.
# "/api/v1" działa przez proxy Vite (bez CORS); bez proxy np. http://localhost:8000/api/v1
# (backend ma CORS z allow_origins=["*"]).
VITE_API_URL=/api/v1
# Tylko dla serwera deweloperskiego: dokąd proxy przekazuje /api
BACKEND_PROXY_TARGET=http://localhost:8000
