# Skopiuj do backend/.env i uzupełnij. Plik .env jest w .gitignore: nie commituj kluczy.

# --- Warstwa danych (gałąź backend-dane) ---
# memory   = dane przykładowe w pamięci (domyślnie, znikają po restarcie)
# supabase = istniejąca baza Supabase (najpierw uruchom supabase/schema-additions.sql)
DATA_BACKEND=memory

# Adres projektu: Supabase → Project Settings → API → Project URL (bez /rest/v1)
SUPABASE_URL=
# Klucz service_role (Project Settings → API). Tylko na serwerze, nigdy we frontendzie.
SUPABASE_KEY=
SUPABASE_TIMEOUT_SECONDS=15

# Opcjonalnie: stała „dzisiejsza data” do pokazu (statusy terminów), format RRRR-MM-DD
# DATA_TODAY=2026-11-21

# --- Istniejące ustawienia backendu (app/core/config.py), opcjonalne ---
# ALLOWED_ORIGINS=http://localhost:5173
# GEMINI_API_KEY=
