# Skopiuj do backend/.env i uzupełnij. backend/.env jest w .gitignore – nie commituj kluczy.
# Na hostingu (Azure Container Apps) te same nazwy ustawia się jako zmienne/sekrety kontenera.

# --- Baza danych (Supabase → Project Settings → Database → Connection string → URI) ---
# Pooler transakcyjny (port 6543) jest obsługiwany. Przy starcie backend sam dodaje brakujące
# tabele/kolumny (app/data/migrations, tylko "if not exists"); wyłączenie: DB_AUTO_MIGRATE=false.
DATABASE_URL=postgresql://postgres.<ref>:<haslo>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
# DB_AUTO_MIGRATE=true
# Bez DATABASE_URL backend działa na danych przykładowych w pamięci (DATA_BACKEND=memory).
# DATA_BACKEND=postgres

# --- Bezpieczeństwo ---
# Sekret podpisu tokenów sesji (JWT HS256). Wymagany na serwerze: bez niego każdy restart unieważnia sesje,
# a repliki nie rozpoznają cudzych tokenów. Wygeneruj np.: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=<losowy-ciag-min-32-znaki>
# Ważność tokenu w minutach (domyślnie 480 = 8 h).
# AUTH_TOKEN_TTL_MINUTES=480
# Tylko testy/dev: zezwala na nagłówek X-User-Id bez tokenu. Na serwerze NIE ustawiać.
# AUTH_ALLOW_DEMO_HEADER=false
# Adresy frontendu, z których przeglądarka może wołać API (przecinki). Frontend serwowany przez
# backend (ten sam adres) nie potrzebuje wpisu; wpisz serwer Vite i ewentualny osobny hosting frontendu.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://kompas-api.calmwater-95f16d05.swedencentral.azurecontainerapps.io

# --- Asystent AI (LLM) ---
# Dostawca rozpoznawany po kluczu: AIza… / AQ.… = Google Gemini (AI Studio), gsk_… = Groq,
# sk-or-… = OpenRouter, sk-… = OpenAI. Pusty klucz lub "placeholder" = tryb RAG bez LLM (cytaty źródeł).
# Wpisuj BEZ cudzysłowów.
LLM_API_KEY=
# Zalecany (szybki, ~4–8 s): gemini-3.5-flash. gemini-4-hydrogen odpowiada 50–110 s i bywa przeciążony.
LLM_MODEL_NAME=gemini-3.5-flash
# Modele zapasowe przy przeciążeniu (429/503) lub przekroczeniu czasu; domyślnie dla Gemini:
# LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-flash-lite-latest
# LLM_TIMEOUT_SECONDS=25          # limit jednej próby
# LLM_TOTAL_BUDGET_SECONDS=55     # limit całej odpowiedzi
# LLM_PROVIDER=gemini
# Model on-premise zgodny z OpenAI (Ollama/vLLM/Bielik): LLM_BASE_URL=http://host:11434/v1

# --- Opcjonalne ---
# DATA_TODAY=2026-11-21        # stała "dzisiejsza data" do pokazu (statusy terminów)
# SUPABASE_URL= / SUPABASE_KEY= # alternatywa: dostęp przez REST Supabase (DATA_BACKEND=supabase)
